# Configurações do banco de dados
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/eleicoes_analytics

# Redis
REDIS_URL=redis://localhost:6379

# MinIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=eleicoes-data

# Spark
SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=Eleicoes_Analytics

# APIs Externas
TSE_BASE_URL=https://dadosabertos.tse.jus.br
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1

# APIs de Redes Sociais (opcional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Segurança
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level} | {name}:{function}:{line} | {message}

# Caminhos de dados
DATA_PATH=/app/data
BRONZE_PATH=/app/data/bronze
SILVER_PATH=/app/data/silver
GOLD_PATH=/app/data/gold

# Processamento
BATCH_SIZE=1000
MAX_WORKERS=4

# Anos de eleições
ELECTION_YEARS_MAJOR=2022,2018,2014,2010
ELECTION_YEARS_LOCAL=2020,2016,2012,2008

# Desenvolvimento
DEBUG=True
ENVIRONMENT=development